__pycache__
*.egg-info
.vscode
.venv
.env
.coverage
.DS_Store
# Keep the dockets directory present in the repo, but ignore any downloaded contents.
dockets/*
!dockets/.gitkeep
db/dockets/*
!db/dockets/.gitkeep
frontend/dist/
frontend/node_modules/
gunicorn.pid
downloads/
gunicorn-access.log
gunicorn-error.log
worker.log
worker.pid

# npm / Node
node_modules/
frontend/node_modules/
package-lock.json
# Track frontend/package-lock.json for fast `npm ci` on EC2
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vite build artifacts with hashed names
index-*.js
index-*.css
/static/
static/index-*.js
static/index-*.css
static/assets/index-*.js
static/assets/index-*.css
